# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: HTTP port for the Express server (default: 3000).
PORT="3000"

# DATA_DIR: Directory for persistent user/progress JSON storage on external servers/Docker.
DATA_DIR="./data"

# CORS_ORIGIN: Optional comma-separated allowed origins when frontend is hosted separately (e.g. GitHub Pages).
# Example: CORS_ORIGIN="https://username.github.io"
CORS_ORIGIN=""

# VITE_API_BASE_URL: Optional external backend URL when deploying frontend to GitHub Pages.
# Leave empty to use same-origin /api or automatic browser-local mode on static hosts.
VITE_API_BASE_URL=""

# VITE_BASE_PATH: Asset base path for Vite build (default: "./" for GitHub Pages and subpath hosting).
VITE_BASE_PATH="./"
